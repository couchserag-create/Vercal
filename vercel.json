{
  "version": 2,
  "public": true,
  "builds": [
    { "src": "dist/assets/**", "use": "@vercel/static" },
    { "src": "dist/index.html", "use": "@vercel/static" },
    { "src": "dist/server.cjs", "use": "@vercel/node" }
  ],
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "dist/assets/$1"
    },
    {
      "src": "/api/(.*)",
      "dest": "dist/server.cjs"
    },
    {
      "src": "/(.*)",
      "dest": "dist/index.html"
    }
  ]
}
